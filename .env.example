# Optional locally — without these an in-memory store is used.
# On Vercel, adding Upstash Redis from the Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CLI only: default server for `npx @simplyzee/webhook-inspector`
# WEBHOOK_INSPECTOR_SERVER=https://webhook-inspector.simplyzee.dev
